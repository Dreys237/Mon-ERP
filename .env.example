# Copiez ce fichier en ".env" et remplissez les valeurs. Ne publiez jamais .env.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Sur PythonAnywhere : votreutilisateur.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=votreutilisateur.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://votreutilisateur.pythonanywhere.com
# sqlite (défaut, compte gratuit) | mysql (compte payant) | postgres
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
